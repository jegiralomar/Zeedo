# Caddyfile: Automatic SSL & WebSocket Reverse Proxy for Zeedo

# 1. Main Marketplace Domain (https://zeedo.auction)
{$DOMAIN:zeedo.auction} {
    # WebSocket route upgrade
    handle /ws* {
        reverse_proxy websocket:8080
    }

    # Gateway broadcast and health endpoints
    handle /broadcast* {
        reverse_proxy websocket:8080
    }
    handle /health* {
        reverse_proxy websocket:8080
    }

    # All other HTTP / Next.js web routes
    handle {
        reverse_proxy web:3000
    }

    encode zstd gzip
}

# 2. Operations Admin Domain (https://admin.zeedo.auction)
{$ADMIN_DOMAIN:admin.zeedo.auction} {
    handle /ws* {
        reverse_proxy websocket:8080
    }

    handle /broadcast* {
        reverse_proxy websocket:8080
    }
    handle /health* {
        reverse_proxy websocket:8080
    }

    handle {
        reverse_proxy web:3000
    }

    encode zstd gzip
}

# 3. Direct IP Access (For testing via raw IP before DNS cutover)
http:// {
    handle /ws* {
        reverse_proxy websocket:8080
    }
    handle /health* {
        reverse_proxy websocket:8080
    }
    handle {
        reverse_proxy web:3000
    }
    encode zstd gzip
}

