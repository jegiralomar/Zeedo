# Caddyfile: Automatic SSL & WebSocket Reverse Proxy for Zeedo

# 1. Main Marketplace Domain (https://zeedo.bid)
{$DOMAIN:zeedo.bid}, zeedo.bid {
    # WebSocket route upgrade
    handle /ws* {
        reverse_proxy websocket:8080
    }

    # Gateway broadcast and health endpoints
    handle /broadcast* {
        reverse_proxy websocket:8080
    }
    handle /health* {
        reverse_proxy websocket:8080
    }

    # All other HTTP / Next.js web routes
    handle {
        reverse_proxy web:3000
    }

    encode zstd gzip
}

# 2. Operations Admin Domain (https://admin.zeedo.bid)
{$ADMIN_DOMAIN:admin.zeedo.bid}, admin.zeedo.bid {
    handle /ws* {
        reverse_proxy websocket:8080
    }

    handle_path /whatsapp* {
        reverse_proxy whatsapp-gateway:3001
    }

    handle /broadcast* {
        reverse_proxy websocket:8080
    }
    handle /health* {
        reverse_proxy websocket:8080
    }

    handle {
        reverse_proxy web:3000
    }

    encode zstd gzip
}

# 3. WWW Subdomain Redirect (https://www.zeedo.bid -> https://zeedo.bid)
www.zeedo.bid {
    redir https://zeedo.bid{uri} permanent
}

# 4. Direct IP Access (For testing via raw IP before DNS cutover)
http:// {
    handle /ws* {
        reverse_proxy websocket:8080
    }
    handle /health* {
        reverse_proxy websocket:8080
    }
    handle {
        reverse_proxy web:3000
    }
    encode zstd gzip
}
