# ==============================================================================
# ZEEDO BID APP — Production Environment Configuration (.env)
# ==============================================================================

# 1. Domains
DOMAIN=zeedo.bid
ADMIN_DOMAIN=admin.zeedo.bid

# 2. Database (If using the internal Docker PostgreSQL container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_super_strong_password_here_123!
POSTGRES_DB=zeedodb
# If continuing to use external Neon PostgreSQL instead:
# DATABASE_URL=postgresql://neondb_owner:npg_xxx@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# 3. Real-Time Bidding WebSocket Gateway
WS_BROADCAST_SECRET=zeedo_internal_live_socket_key_9898
NEXT_PUBLIC_WS_URL=wss://zeedo.bid/ws

# 4. 90-Day Mobile Session Authentication
SESSION_SECRET=generate_a_long_random_jwt_secret_key_minimum_32_characters

# 5. Gemini AI Catalog Intelligence
GEMINI_API_KEY=your_gemini_api_key_here

# 6. Meta WhatsApp Cloud API (Iraq +964)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=zeedo_auth_otp

# 7. Cloudflare R2 Media Storage ($0 Egress Free Tier)
R2_ACCOUNT_ID=d6f69e4857b3ca965a9886f5da819769
R2_ACCESS_KEY_ID=2cc1deddf94a06384e628da6b237122e
R2_SECRET_ACCESS_KEY=932d0aa3889176166ac0a4e9091822ab3fea38ec6931ca846cf57ef121573cb1
R2_BUCKET_NAME=zeedo-media
R2_PUBLIC_DOMAIN=https://pub-fcbade1594ed4975bfb13512a9680406.r2.dev
