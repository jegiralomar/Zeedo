{
  "expo": {
    "name": "Zeedo - زيدو",
    "slug": "zeedo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#F83758",
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeedo.bid",
      "infoPlist": {
        "NSCameraUsageDescription": "Zeedo needs camera access for National ID KYC verification.",
        "NSPhotoLibraryUsageDescription": "Zeedo needs photo access to upload inspection photos."
      }
    },
    "android": {
      "package": "com.zeedo.bid",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "zeedo-bid-production"
      }
    }
  }
}
